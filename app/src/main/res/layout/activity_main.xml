<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<LinearLayout
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/statusText"
        android:text="@string/status_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/startButton"
        android:text="@string/start_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/stopButton"
        android:text="@string/stop_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <Button
        android:id="@+id/ttsSettingsButton"
        android:text="@string/use_as_tts_engine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="@string/tts_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp" />

    <TextView
        android:text="Voice"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp" />

    <RadioGroup
        android:id="@+id/voiceGroup"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/voiceSky"
            android:text="Sky (default — bright, fast)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <RadioButton
            android:id="@+id/voiceNicole"
            android:text="Nicole (warm, slower)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </RadioGroup>

    <TextView
        android:id="@+id/speedLabel"
        android:text="Speed: 1.25x"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp" />

    <SeekBar
        android:id="@+id/speedSeek"
        android:max="150"
        android:progress="75"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:text="0.5x (slow) ————— 2.0x (fast)"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:text="Acceleration (takes effect immediately, rebuilds session)"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp" />

    <RadioGroup
        android:id="@+id/epGroup"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/epAuto"
            android:text="Auto (GPU → NNAPI → CPU)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <RadioButton
            android:id="@+id/epNnapi"
            android:text="NNAPI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <RadioButton
            android:id="@+id/epGpu"
            android:text="GPU (NNAPI FP16)"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <RadioButton
            android:id="@+id/epCpu"
            android:text="CPU"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </RadioGroup>

    <TextView
        android:id="@+id/inferStats"
        android:text="Inference: —"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/engineStatus"
        android:text="Engine: starting…"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp" />
</LinearLayout>
</ScrollView>
